---
import "@styles/liquid-glass.css";
import { NAV_PAGES } from "@components/nav-pages";

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Online Clipboard | dulith.me",
  description = "Free, fast online clipboard with optional end-to-end encryption, burn-after-read, Markdown preview, real-time WebSocket sync, collaborative scribble, file sharing, and URL analytics.",
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  structuredData,
} = Astro.props;

const siteOrigin = "https://clipboard.dulith.me";
const canonicalUrl = `${siteOrigin}${canonicalPath === "/" ? "/" : canonicalPath.replace(/\/+$/, "")}`;
const ogImage = `${siteOrigin}/og-image.png?v=2`;
const pathname = Astro.url.pathname;

const defaultAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Clipboard by dulith.me",
  url: siteOrigin,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description,
  featureList: [
    "Cross-device text, Markdown, code, and image clipboard",
    "Browser-side AES-256-GCM zero-knowledge encryption",
    "Burn-after-read and custom TTL expiration",
    "Real-time WebSocket live clipboard and collaborative scribble",
    "Encrypted file drop up to 98 MB",
    "URL shortener with browser, OS, and device analytics",
    "Apple Shortcuts, Android HTTP Shortcuts, and curl REST API",
  ],
};

const jsonLdPayload = structuredData
  ? Array.isArray(structuredData)
    ? [defaultAppSchema, ...structuredData]
    : [defaultAppSchema, structuredData]
  : [defaultAppSchema];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta id="themeColorMeta" name="theme-color" content="#f2f4f8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("cb-theme");
          var mode =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", mode);
          var m = document.getElementById("themeColorMeta");
          if (m) m.setAttribute("content", mode === "dark" ? "#090a10" : "#f2f4f8");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="online clipboard, free online clipboard, clipboard online, encrypted pastebin, live clipboard, collaborative whiteboard, file drop, url shortener, apple shortcuts clipboard, clipboard.dulith.me"
    />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Icons & PWA -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link id="faviconLink" rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="clipboard.dulith.me" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="clipboard.dulith.me Liquid Glass workspace preview" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdPayload.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body>
    <!-- Layer 1: Ambient Color Field -->
    <div class="ambient-field" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <div class="shell">
      <!-- Layer 2: Floating Pill Navbar -->
      <header class="top-bar liquid-glass">
        <a href="/" class="brand" aria-label="Clipboard Home">
          <span class="brand-icon">
            <img src="/favicon.png" alt="" width="28" height="28" />
          </span>
          <span>Clipboard</span>
        </a>

        <nav id="desktopNav" class="nav-links-desktop" aria-label="Primary navigation">
          <span id="navBubble" class="nav-bubble" aria-hidden="true"></span>
          {
            NAV_PAGES.map((p) => {
              const active = p.href === "/" ? pathname === "/" : pathname.startsWith(p.href);
              return (
                <a
                  href={p.href}
                  draggable="false"
                  class={`nav-link ${active ? "active" : ""}`}
                  aria-current={active ? "page" : undefined}
                >
                  {p.shortName}
                </a>
              );
            })
          }
        </nav>
        <script is:inline>
          (function () {
            try {
              var b = document.getElementById("navBubble");
              var nav = document.getElementById("desktopNav");
              if (!b || !nav) return;
              var prev = sessionStorage.getItem("cb-nav-bubble");
              var target = prev ? JSON.parse(prev) : null;
              var active = nav.querySelector(".nav-link.active");
              if (target && typeof target.x === "number" && typeof target.w === "number") {
                b.style.transition = "none";
                b.style.width = target.w + "px";
                b.style.transform = "translate3d(" + target.x + "px, 0, 0)";
                b.style.opacity = "1";
              } else if (active && active.offsetWidth > 0) {
                b.style.transition = "none";
                b.style.width = active.offsetWidth + "px";
                b.style.transform = "translate3d(" + active.offsetLeft + "px, 0, 0)";
                b.style.opacity = "1";
              }
            } catch (e) {}
          })();
        </script>

        <div class="nav-actions">
          <a
            href="https://github.com/dulithdivisekara/online-clipboard"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-circle-btn"
            aria-label="View source repository on GitHub"
            title="GitHub Repository"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>

          <button
            id="themeToggleBtn"
            type="button"
            class="theme-toggle"
            aria-label="Switch between Light and Dark theme"
            title="Switch Light / Dark theme"
          >
            <svg class="theme-ico theme-ico-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="theme-ico theme-ico-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span id="themeLabel" class="theme-label">Light</span>
          </button>

          <button
            id="mobileMenuBtn"
            type="button"
            class="mobile-menu-btn"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobileNavPopover"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <span>Menu</span>
          </button>
        </div>
      </header>

      <nav id="mobileNavPopover" class="mobile-nav-popover liquid-glass" aria-label="Mobile navigation">
        {
          NAV_PAGES.map((p) => {
            const active = p.href === "/" ? pathname === "/" : pathname.startsWith(p.href);
            return (
              <a
                href={p.href}
                class={`mobile-nav-item ${active ? "active" : ""}`}
                aria-current={active ? "page" : undefined}
              >
                <span>{p.name}</span>
                {active && <span aria-hidden="true">Active</span>}
              </a>
            );
          })
        }
      </nav>

      <main style="display:flex;flex-direction:column;gap:20px;">
        <slot />
      </main>

      <footer class="site-footer">
        <span class="footer-copy">© 2026 Dulith Divisekara. All rights reserved.</span>
        <span class="footer-credit">
          <span>Open source by</span>
          <a
            href="https://github.com/dulithdivisekara"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span>@dulithdivisekara</span>
          </a>
        </span>
      </footer>
    </div>

    <!-- Floating Toast -->
    <div id="globalToast" class="toast liquid-glass" role="status" aria-live="polite"></div>

    <script>
      import { attachNavBubble, initLiquidOptics } from "@lib/liquid-optics";

      type ThemeMode = "light" | "dark";

      function resolveTheme(): ThemeMode {
        const attr = document.documentElement.getAttribute("data-theme");
        if (attr === "light" || attr === "dark") return attr;
        try {
          const saved = localStorage.getItem("cb-theme");
          if (saved === "light" || saved === "dark") return saved;
        } catch {
          // ignore
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }

      function applyTheme(mode: ThemeMode, persist = true) {
        document.documentElement.setAttribute("data-theme", mode);
        if (persist) {
          try {
            localStorage.setItem("cb-theme", mode);
          } catch {
            // ignore
          }
        }
        const label = document.getElementById("themeLabel");
        if (label) label.textContent = mode === "dark" ? "Dark" : "Light";
        const meta = document.getElementById("themeColorMeta");
        if (meta) meta.setAttribute("content", mode === "dark" ? "#090a10" : "#f2f4f8");
      }

      applyTheme(resolveTheme(), false);

      const themeBtn = document.getElementById("themeToggleBtn");
      themeBtn?.addEventListener("click", () => {
        const next: ThemeMode = resolveTheme() === "dark" ? "light" : "dark";
        document.documentElement.classList.add("theme-transitioning");
        window.setTimeout(() => document.documentElement.classList.remove("theme-transitioning"), 260);
        applyTheme(next, true);
      });

      // Mobile nav popover
      const menuBtn = document.getElementById("mobileMenuBtn");
      const popover = document.getElementById("mobileNavPopover");
      menuBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = popover?.classList.toggle("open");
        menuBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });
      document.addEventListener("click", (e) => {
        if (popover?.classList.contains("open") && !popover.contains(e.target as Node)) {
          popover.classList.remove("open");
          menuBtn?.setAttribute("aria-expanded", "false");
        }
      });

      // Global toast bus
      let toastTimer: number | undefined;
      window.addEventListener("cb:toast", (ev: Event) => {
        const detail = (ev as CustomEvent<{ message: string; kind?: string }>).detail;
        const toast = document.getElementById("globalToast");
        if (!toast || !detail?.message) return;
        toast.textContent = detail.message;
        toast.className = `toast liquid-glass visible ${detail.kind === "err" ? "err" : "ok"}`;
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove("visible");
        }, 2600);
      });

      initLiquidOptics();
      attachNavBubble(document.getElementById("desktopNav"));
    </script>
  </body>
</html>
