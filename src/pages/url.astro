---
import PageLayout from "@layouts/PageLayout.astro";
import UrlShortenerPanel from "@components/UrlShortenerPanel";
---

<PageLayout
  title="URL Shortener | Clipboard"
  description="Create clean short links with custom aliases, expiration timers, QR codes, and real-time browser, OS, country, and device analytics."
  canonicalPath="/url"
>
  <section class="hero">
    <h1>URL Shortener &amp; Analytics</h1>
    <p>
      Shorten links in one click, share via QR code, and append <code>+</code> to any short link to inspect visitor analytics.
    </p>
  </section>

  <UrlShortenerPanel client:load origin={Astro.url.origin} />
</PageLayout>
