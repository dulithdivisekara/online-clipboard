---
import PageLayout from "@layouts/PageLayout.astro";
import VaultDashboard from "@components/VaultDashboard";
---

<PageLayout
  title="Vault | Clipboard"
  description="View your recent local clips or unlock the protected Owner Storage Vault."
  canonicalPath="/vault"
  noIndex={true}
>
  <section class="hero">
    <h1>Personal Vault</h1>
    <p>
      Quickly revisit clips created on this browser or sign in with your owner passcode to manage R2 storage and active links.
    </p>
  </section>

  <VaultDashboard client:load />
</PageLayout>
