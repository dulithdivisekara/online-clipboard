---
import PageLayout from "@layouts/PageLayout.astro";
import ScribbleBoard from "@components/ScribbleBoard";
import { generateShortId } from "@lib/crypto";

const requestedId = (Astro.url.searchParams.get("id") || "").trim().toLowerCase();
const roomId = /^[a-z0-9-_]{2,64}$/i.test(requestedId)
  ? requestedId
  : generateShortId(6, "alnum");
---

<PageLayout
  title="Collaborative Scribble — Live Whiteboard | clipboard.dulith.me"
  description="Draw, sketch diagrams, and collaborate live across phones, tablets, and desktops with instant PNG export and QR room sharing."
  canonicalPath="/scribble"
  noIndex={Boolean(requestedId)}
>
  <section class="hero">
    <span class="eyebrow">Multi-User Canvas</span>
    <h1>Collaborative Scribble</h1>
    <p>
      Sketch ideas together in real time across touchscreens and desktops, then export as a crisp PNG.
    </p>
  </section>

  <ScribbleBoard client:load roomId={roomId} />
</PageLayout>
