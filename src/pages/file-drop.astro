---
import PageLayout from "@layouts/PageLayout.astro";
import FileDropZone from "@components/FileDropZone";
import { generateShortId } from "@lib/crypto";

const requestedId = (Astro.url.searchParams.get("id") || "").trim().toLowerCase();
const roomId = /^[a-z0-9-_]{2,64}$/i.test(requestedId)
  ? requestedId
  : generateShortId(6, "alnum");
---

<PageLayout
  title="File Drop | Clipboard"
  description="Send files up to 98 MB across devices with drag-and-drop progress, download limits, password protection, QR codes, and live room alerts."
  canonicalPath="/file-drop"
  noIndex={Boolean(requestedId)}
>
  <section class="hero">
    <h1>Instant File Drop</h1>
    <p>
      Drag and drop files up to 98 MB, set download limits or a password, and receive them live on paired devices.
    </p>
  </section>

  <FileDropZone client:load roomId={roomId} />
</PageLayout>
