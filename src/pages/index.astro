---
import PageLayout from "@layouts/PageLayout.astro";
import ClipboardWorkspace from "@components/ClipboardWorkspace";
import { getEnv, sanitizeClipForClient, type ClipRow } from "@lib/server";
import { isExpired } from "@lib/ttl";

const { searchParams } = Astro.url;

const realtimeId = searchParams.get("lc_id");
if (realtimeId) {
  return Astro.redirect(`/live-clipboard?id=${encodeURIComponent(realtimeId)}`);
}

const cbId = (searchParams.get("id") || "").trim().toLowerCase();
let initialClip: any = null;
let initialRequiresPassword = false;
let initialNeedsReveal = false;

if (cbId) {
  try {
    const env = getEnv();
    const row = await env.CLIPBOARD_DB.prepare("SELECT * FROM clips WHERE id = ?")
      .bind(cbId)
      .first<ClipRow>();
    if (row && !isExpired(row.expires_at) && !(row.max_views > 0 && row.view_count >= row.max_views)) {
      if (row.password_hash) {
        initialRequiresPassword = true;
      } else if (row.max_views > 0) {
        // Never consume burn-after-read views on SSR/bot prefetch; require explicit reveal click
        initialNeedsReveal = true;
      } else if (row.kind === "image" || row.kind === "file") {
        initialClip = {
          ...sanitizeClipForClient(row),
          downloadUrl: `/api/v1/files/${encodeURIComponent(row.id)}`,
        };
      } else {
        initialClip = sanitizeClipForClient(row);
      }
    }
  } catch {
    // Ignore SSR lookup errors and allow client retry
  }
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How does Zero-Knowledge End-to-End Encryption work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "When Zero-Knowledge E2EE is enabled, your browser encrypts the text with AES-256-GCM before sending it to Cloudflare. The decryption key stays exclusively in the URL #fragment and is never transmitted to the server.",
      },
    },
    {
      "@type": "Question",
      name: "How do I edit a clip after saving it?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Enable Allow Future Edits (or end your custom ID with -e) and set a password when saving. Only callers with that password can update the clip content.",
      },
    },
    {
      "@type": "Question",
      name: "Can I sync my clipboard from iPhone Shortcuts or terminal?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Visit the Shortcuts API page for ready-to-use Apple Shortcuts, Android HTTP Shortcuts, and curl commands powered by /api/v1/quick.",
      },
    },
  ],
};
---

<PageLayout
  title={cbId ? `Clip ${cbId} | Clipboard` : "Online Clipboard | dulith.me"}
  description="Transfer text, Markdown, code, images, and files across devices in seconds with optional AES-256-GCM encryption, burn-after-read limits, and real-time WebSocket rooms."
  canonicalPath="/"
  noIndex={Boolean(cbId)}
  structuredData={faqSchema}
>
  <section class="hero">
    <h1>Instant Cross-Device Clipboard</h1>
    <p>
      Save and retrieve text, Markdown, syntax-highlighted code, or images across phones and computers with optional zero-knowledge encryption and burn-after-read links.
    </p>
  </section>

  <ClipboardWorkspace
    client:load
    initialId={cbId}
    initialClip={initialClip}
    initialRequiresPassword={initialRequiresPassword}
    initialNeedsReveal={initialNeedsReveal}
  />

  <section class="glass-card grouped-list" aria-label="Frequently Asked Questions">
    <details>
      <summary>
        <span>How does Zero-Knowledge End-to-End Encryption work?</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </summary>
      <div class="grouped-body">
        Enabling Zero-Knowledge E2EE encrypts your text inside the browser using Web Crypto AES-256-GCM before uploading. The secret key is appended after the URL <code>#key=</code> hash, which browsers never send in HTTP requests.
      </div>
    </details>

    <details>
      <summary>
        <span>How do Burn-After-Read and Expiration TTLs work?</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </summary>
      <div class="grouped-body">
        Every clip supports automatic expiration (1 hour, 1 day, 7 days, 30 days, or never) plus an optional view limit. Once the view limit is reached or TTL expires, the clip and any attached R2 file are permanently purged.
      </div>
    </details>

    <details>
      <summary>
        <span>How do editable clips (-e) and passwords work?</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </summary>
      <div class="grouped-body">
        Turn on <strong>Allow Future Edits</strong> or suffix your custom ID with <code>-e</code>. Passwords are hashed server-side with salted PBKDF2-SHA256 (100,000 iterations) and are never returned to clients.
      </div>
    </details>
  </section>
</PageLayout>
