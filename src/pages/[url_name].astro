---
import PageLayout from "@layouts/PageLayout.astro";
import UrlAnalyticsView from "@components/UrlAnalyticsView";
import { resolveShortUrlOrStats } from "@lib/url-redirect";
import { getEnv } from "@lib/server";

const param = Astro.params.url_name || "";

// Never query D1 for dotted asset paths; serve static asset fallback if present
if (param.includes(".")) {
  const env = getEnv() as App.Env & { ASSETS?: Fetcher };
  if (env.ASSETS) {
    const assetRes = await env.ASSETS.fetch(Astro.request);
    if (assetRes.status !== 404) {
      return assetRes;
    }
  }
  return new Response("Not Found", { status: 404 });
}

const result = await resolveShortUrlOrStats(
  param,
  Astro.request,
  Astro.locals.cfContext
);

if (result.action === "redirect") {
  return Astro.redirect(result.targetUrl, 302);
}

if (result.action === "not_found") {
  Astro.response.status = 404;
}
---

<PageLayout
  title={result.action === "stats" ? `Analytics /${result.stats.code} | clipboard.dulith.me` : "Page Not Found | clipboard.dulith.me"}
  description="Shortened URL analytics and redirect."
  noIndex={true}
>
  {
    result.action === "stats" ? (
      <>
        <section class="hero">
          <span class="eyebrow">Short Link Analytics</span>
          <h1>Link Telemetry</h1>
        </section>
        <UrlAnalyticsView client:load {...result.stats} />
      </>
    ) : (
      <section class="glass-card sheet" style="text-align:center;">
        <h1 style="margin:0;font-size:24px;">Page or short link not found</h1>
        <p style="color:var(--label-secondary);margin:0;">
          The requested page or short link does not exist or has expired.
        </p>
        <div style="margin-top:8px;">
          <a href="/" class="primary-btn">Back to Clipboard</a>
        </div>
      </section>
    )
  }
</PageLayout>
